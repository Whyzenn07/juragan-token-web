# 1. Gateway Base URL
GATEWAY_BASE_URL="https://gateway.juragantoken.co.id/v1"

# 2. Gmail SMTP Credentials (Google App Password / Sandi Aplikasi 16 Karakter)
# Dapatkan di: https://myaccount.google.com/apppasswords
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
GMAIL_FROM_NAME="Juragan Token Indonesia"
