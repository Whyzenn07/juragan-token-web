# ==============================================================================
# JURAGAN TOKEN - VERCEL & HOSTING ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Catatan Handover:
# Seluruh sistem website, database Supabase, dan email struk sudah 100% siap.
# Tim Developer hanya perlu mengisi 2 BAGIAN di bawah ini (BAGIAN A & BAGIAN B)
# ketika kredensial produksi sudah tersedia.
# ==============================================================================

# ------------------------------------------------------------------------------
# [BAGIAN A] ITEM HANDOVER #1: MASTER API KEY LLM (https://api.tokotokenai.com)
# ------------------------------------------------------------------------------
GATEWAY_BASE_URL="https://api.tokotokenai.com/v1"
UPSTREAM_ENGINE_URL="https://api.tokotokenai.com/v1"
# Isi dengan Master API Key dari server https://api.tokotokenai.com/v1:
UPSTREAM_ENGINE_KEY=""
# Set "true" jika ingin seluruh model (termasuk Gemini) melewati api.tokotokenai.com:
UPSTREAM_ROUTE_ALL="false"

# ------------------------------------------------------------------------------
# [BAGIAN B] ITEM HANDOVER #2: PAYMENT GATEWAY RESMI (Tripay / Midtrans / Xendit)
# ------------------------------------------------------------------------------
# Pilihan provider: "manual" (default saat ini) | "tripay" | "midtrans" | "xendit"
PAYMENT_GATEWAY_PROVIDER="manual"
PAYMENT_GATEWAY_SANDBOX="false"

# Ubah DEMO_MODE & NEXT_PUBLIC_DEMO_MODE menjadi "false" saat Payment Gateway Live:
DEMO_MODE="true"
NEXT_PUBLIC_DEMO_MODE="true"

# Opsi 1: Jika menggunakan Tripay
TRIPAY_MERCHANT_CODE=""
TRIPAY_API_KEY=""
TRIPAY_PRIVATE_KEY=""

# Opsi 2: Jika menggunakan Midtrans
MIDTRANS_SERVER_KEY=""
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=""

# Opsi 3: Jika menggunakan Xendit
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# ------------------------------------------------------------------------------
# [BAGIAN C] INFRASTRUKTUR YANG SUDAH AKTIF & TERKONFIGURASI (100% READY)
# ------------------------------------------------------------------------------
# 1. Domain & WhatsApp CS
NEXT_PUBLIC_APP_URL="https://juragan-token-web-retail-git-main-whyzenn07s-projects.vercel.app"
NEXT_PUBLIC_WHATSAPP_NUMBER="6281226983990"

# 2. Supabase Cloud Database (Orders, Keys, & Usage Logs)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"

# 3. Direct Gemini Engine (Fallback & Model Gemini)
GEMINI_API_KEY="your-gemini-api-key-from-google-ai-studio"

# 4. Gmail SMTP (Pengiriman Bukti Transaksi Email Otomatis)
GMAIL_USER="your-email@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx"
GMAIL_FROM_NAME="Juragan Token Indonesia"

# 5. Secret Admin Konfirmasi Manual
ADMIN_SECRET="your-random-32-chars-secret"
